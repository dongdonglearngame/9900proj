PROPOSER_SEED=0
S2_PROMPT_VARIANT=v5_baseline
PROPOSER_NUM_PREDICT=512
PROPOSER_CANDIDATES_PER_ROUND=4
PROPOSER_MAX_ROUNDS=2
S2_PROPOSER_NUM_PREDICT=1024
S2_PROPOSER_CANDIDATES_PER_ROUND=4
S2_PROPOSER_MAX_ROUNDS=2
S6_PROPOSER_NUM_PREDICT=512
S6_PROPOSER_CANDIDATES_PER_ROUND=4
S6_PROPOSER_MAX_ROUNDS=2
