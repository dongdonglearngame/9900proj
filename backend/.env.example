APP_ENV=development
USE_MOCK_LLM=true
DATABASE_URL=sqlite:///./p18_dev.db
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b
TARGET_PROMPT_VERSION=target-v2-chat-dynamic-choices
TOP_LOGPROBS=20
TARGET_NUM_PREDICT=4
PROPOSER_MODEL=llama3.2:3b
PROPOSER_TEMPERATURE=0.7
PROPOSER_SEED=0
PROPOSER_NUM_PREDICT=512
PROPOSER_CANDIDATES_PER_ROUND=4
PROPOSER_MAX_ROUNDS=2
PROPOSER_MAX_CHANGED_FRACTION=0.6
